# Copy to .env and replace database passwords; provision the mail key separately.
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
TEST_POSTGRES_PASSWORD=replace-with-a-local-test-password
TEST_POSTGRES_PORT=55432
# Local SMTP capture only; cargo does not load .env automatically.
TEST_SMTP_PORT=1025
TEST_MAILPIT_PORT=8025
MAIL_FROM=crow@example.test
CROW_ORIGIN=http://localhost:3000
MAIL_ENCRYPTION_KEY=replace-with-a-separately-provisioned-32-byte-base64url-key
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_LOCAL_CAPTURE=true
# Production: MAIL_LOCAL_CAPTURE=false, HTTPS origin and mandatory STARTTLS SMTP.
# SMTP_USERNAME and SMTP_PASSWORD must either both be set or both be absent.
# Required only when constructing the upcoming hosted browser routes; separate key.
BROWSER_SIGNING_KEY=replace-with-a-separately-provisioned-32-byte-base64url-key
# Hosted browser CROW_ORIGIN must be canonical HTTPS (without a trailing slash).
